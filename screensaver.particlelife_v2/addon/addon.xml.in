<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="screensaver.particlelife_v2"
  version="1.0.0"
  name="particlelife_v2"
  provider-name="Patrick Hoepner">
  <requires>@ADDON_DEPENDS@</requires>
  <extension point="xbmc.ui.screensaver" library_@PLATFORM@="@LIBRARY_FILENAME@"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <summary lang="en_GB">Particle Life: self-organising coloured particles</summary>
    <description lang="en_GB">Four colours of particles attract and repel each other under randomly generated rules, forming cells, chains and orbiting clusters. The rules are re-rolled on a timer so it never repeats. Based on the Particle Life simulation.</description>
    <license>MIT</license>
    <news>1.0.0 - initial release</news>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
