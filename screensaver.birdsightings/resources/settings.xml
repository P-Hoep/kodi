        <setting id="no_captive" type="boolean" label="30014">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="open_license" type="boolean" label="30015">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="refresh_min" type="integer" label="30016">
          <level>0</level>
          <default>30</default>
          <constraints><minimum>5</minimum><step>5</step><maximum>180</maximum></constraints>
          <control type="slider" format="integer"><popup>false</popup></control>
