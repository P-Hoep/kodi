<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings version="1">
  <section id="screensaver.birdsightings">
    <category id="location" label="30000">
      <group id="1">
        <setting id="location_name" type="string" label="30005">
          <level>0</level>
          <default>Minneapolis, MN</default>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="edit" format="string"><heading>30005</heading></control>
        </setting>
        <setting id="lookup" type="action" label="30004">
          <level>0</level>
          <data>RunScript($ID)</data>
          <constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="action"><close>true</close></control>
        </setting>
        <setting id="latitude" type="string" label="30001">
          <level>0</level>
          <default>44.9778</default>
          <constraints><allowempty>false</allowempty></constraints>
          <control type="edit" format="string"><heading>30001</heading></control>
        </setting>
        <setting id="longitude" type="string" label="30002">
          <level>0</level>
          <default>-93.2650</default>
          <constraints><allowempty>false</allowempty></constraints>
          <control type="edit" format="string"><heading>30002</heading></control>
        </setting>
        <setting id="radius" type="integer" label="30003">
          <level>0</level>
          <default>20</default>
          <constraints><minimum>1</minimum><step>1</step><maximum>200</maximum></constraints>
          <control type="slider" format="integer"><popup>false</popup></control>
        </setting>
      </group>
