<?xml version="1.0" encoding="UTF-8"?>
<!-- The blue screen with a soft vignette, and a black layer for dimming. Python adds the
     letters (pre-rendered glyph images) on top. -->
<window>
  <backgroundcolor>0xff060CE9</backgroundcolor>
  <controls>
    <control type="image">
      <left>-60</left><top>-60</top><width>2040</width><height>1200</height>
      <texture>white.png</texture>
      <colordiffuse>FF060CE9</colordiffuse>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>vignette.png</texture>
      <aspectratio>stretch</aspectratio>
    </control>
    <control type="image" id="10">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>white.png</texture>
      <colordiffuse>$INFO[Window(Home).Property(jeopkodi.dim)]</colordiffuse>
    </control>
  </controls>
</window>
